# Postmark delivers the contact form. The server token must never reach the
# client: it is read only inside app/api/contact/route.ts.
POSTMARK_SERVER_TOKEN=
# Optional. Defaults shown.
# CONTACT_TO_ADDRESS=sales@sanwei-asia.com
# CONTACT_FROM_ADDRESS=website@sanwei-asia.com
# POSTMARK_MESSAGE_STREAM=outbound
